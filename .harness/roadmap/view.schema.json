                          "likely": {
                            "type": "number",
                            "minimum": 0
                          },
                          "pessimistic": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "optimistic",
                          "likely",
                          "pessimistic"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
