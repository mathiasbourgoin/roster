{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roster local commit report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "harness_version", "staged_tree", "elapsed_seconds", "input_tokens", "output_tokens", "agents", "mode", "formal"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"$ref": "#/$defs/identifier"},
    "harness_version": {"$ref": "#/$defs/identifier"},
    "staged_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "elapsed_seconds": {"$ref": "#/$defs/counter"},
    "input_tokens": {"$ref": "#/$defs/counter"},
    "output_tokens": {"$ref": "#/$defs/counter"},
    "agents": {"type": ["array", "null"], "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "mode": {"enum": [null, "express", "fast", "full"]},
    "formal": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "backend"],
      "properties": {
        "status": {"enum": ["not-used", "specified", "verified", "unavailable"]},
        "backend": {"enum": [null, "rocq", "quint"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["specified", "verified"]}}}, "then": {"properties": {"backend": {"enum": ["rocq", "quint"]}}}},
        {"if": {"properties": {"status": {"const": "not-used"}}}, "then": {"properties": {"backend": {"const": null}}}}
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "counter": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
  }
}
